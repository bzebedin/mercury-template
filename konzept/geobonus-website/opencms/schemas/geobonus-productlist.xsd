<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

    <xsd:include schemaLocation="opencms://opencms-xmlcontent.xsd" />
    <xsd:include schemaLocation="opencms://system/modules/alkacon.mercury.template/schemas/nested/link.xsd" />

    <xsd:element name="GbProductListData" type="OpenCmsGbProductListData" />

    <xsd:complexType name="OpenCmsGbProductListData">
        <xsd:sequence>
            <xsd:element name="GbProductList" type="OpenCmsGbProductList" minOccurs="0" maxOccurs="1" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="OpenCmsGbProductList">
        <xsd:sequence>
            <xsd:element name="Eyebrow"      type="OpenCmsString" minOccurs="0" />
            <xsd:element name="Title"        type="OpenCmsString" />
            <xsd:element name="Claim"        type="OpenCmsString" minOccurs="0" />
            <xsd:element name="Product"      type="OpenCmsGbProduct" minOccurs="0" maxOccurs="unbounded" />
            <xsd:element name="GalleryTitle" type="OpenCmsString" minOccurs="0" />
        </xsd:sequence>
        <xsd:attribute name="language" type="OpenCmsLocale" use="required" />
    </xsd:complexType>

    <xsd:complexType name="OpenCmsGbProduct">
        <xsd:sequence>
            <xsd:element name="Variant"     type="OpenCmsString" />
            <xsd:element name="Name"        type="OpenCmsString" />
            <xsd:element name="Description" type="OpenCmsString" minOccurs="0" />
            <xsd:element name="Link"        type="OpenCmsNestedLink" minOccurs="0" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:annotation>
        <xsd:appinfo>
            <resourcebundles>
                <propertybundle name="com.mapexplorer.geobonus.messages" />
                <propertybundle name="alkacon.mercury.template.messages" />
            </resourcebundles>
            <searchsettings containerPageOnly="true" />
            <FieldSettings>
                <Setting>
                    <PropertyName>Eyebrow</PropertyName>
                    <DisplayName><![CDATA[%(key.label.gb.Eyebrow)]]></DisplayName>
                    <Widget>string</Widget>
                </Setting>
                <Setting>
                    <PropertyName>Title</PropertyName>
                    <DisplayName><![CDATA[%(key.label.gb.Title)]]></DisplayName>
                    <Widget>string</Widget>
                    <WidgetConfig><![CDATA[%(attribute:stringConfigTypo)]]></WidgetConfig>
                </Setting>
                <Setting>
                    <PropertyName>Claim</PropertyName>
                    <DisplayName><![CDATA[%(key.label.gb.ProductList.Claim)]]></DisplayName>
                    <Description><![CDATA[%(key.label.gb.ProductList.Claim.help)]]></Description>
                    <Widget>string</Widget>
                    <WidgetConfig><![CDATA[%(attribute:stringConfigTypo)]]></WidgetConfig>
                </Setting>
                <Setting>
                    <PropertyName>Product</PropertyName>
                    <DisplayName><![CDATA[%(key.label.gb.Product)]]></DisplayName>
                    <Description><![CDATA[%(key.label.gb.Product.help)]]></Description>
                </Setting>
                <Setting>
                    <PropertyName>Product/Variant</PropertyName>
                    <DisplayName><![CDATA[%(key.label.gb.Product.Variant)]]></DisplayName>
                    <Widget>select</Widget>
                    <WidgetConfig><![CDATA[digital:%(key.label.gb.Product.Variant.digital)|print:%(key.label.gb.Product.Variant.print)]]></WidgetConfig>
                    <Default><![CDATA[digital]]></Default>
                </Setting>
                <Setting>
                    <PropertyName>Product/Name</PropertyName>
                    <DisplayName><![CDATA[%(key.label.gb.Product.Name)]]></DisplayName>
                    <Widget>string</Widget>
                </Setting>
                <Setting>
                    <PropertyName>Product/Description</PropertyName>
                    <DisplayName><![CDATA[%(key.label.gb.Product.Description)]]></DisplayName>
                    <Widget>string</Widget>
                </Setting>
                <Setting>
                    <PropertyName>Product/Link</PropertyName>
                    <DisplayName><![CDATA[%(key.label.Link)]]></DisplayName>
                    <Description><![CDATA[%(key.label.gb.Product.Link.help)]]></Description>
                </Setting>
                <Setting>
                    <PropertyName>GalleryTitle</PropertyName>
                    <DisplayName><![CDATA[%(key.label.GalleryTitle)]]></DisplayName>
                    <Widget>string</Widget>
                    <Default><![CDATA[%(page_title)%(no_prefix:: )%(value:Title)]]></Default>
                    <DefaultResolveMacros>false</DefaultResolveMacros>
                    <Search>false</Search>
                    <Visibility>ROLE.WORKPLACE_USER</Visibility>
                    <Mapping>
                       <MapTo>property:Title</MapTo>
                       <UseDefault>true</UseDefault>
                    </Mapping>
                </Setting>
            </FieldSettings>
        </xsd:appinfo>
    </xsd:annotation>
</xsd:schema>
