<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

    <xsd:include schemaLocation="opencms://opencms-xmlcontent.xsd" />
    <xsd:include schemaLocation="opencms://system/modules/alkacon.mercury.template/schemas/nested/link.xsd" />

    <xsd:element name="GbReferencesData" type="OpenCmsGbReferencesData" />

    <xsd:complexType name="OpenCmsGbReferencesData">
        <xsd:sequence>
            <xsd:element name="GbReferences" type="OpenCmsGbReferences" minOccurs="0" maxOccurs="1" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="OpenCmsGbReferences">
        <xsd:sequence>
            <xsd:element name="Eyebrow"      type="OpenCmsString" minOccurs="0" />
            <xsd:element name="Title"        type="OpenCmsString" />
            <xsd:element name="Intro"        type="OpenCmsHtml" minOccurs="0" />
            <xsd:element name="Reference"    type="OpenCmsGbReference" minOccurs="0" maxOccurs="unbounded" />
            <xsd:element name="GalleryTitle" type="OpenCmsString" minOccurs="0" />
        </xsd:sequence>
        <xsd:attribute name="language" type="OpenCmsLocale" use="required" />
    </xsd:complexType>

    <xsd:complexType name="OpenCmsGbReference">
        <xsd:sequence>
            <xsd:element name="Title"    type="OpenCmsString" />
            <xsd:element name="Subtitle" type="OpenCmsString" minOccurs="0" />
            <xsd:element name="Count"    type="OpenCmsString" minOccurs="0" />
            <xsd:element name="Link"     type="OpenCmsNestedLink" minOccurs="0" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:annotation>
        <xsd:appinfo>
            <resourcebundles>
                <propertybundle name="com.mapexplorer.geobonus.messages" />
                <propertybundle name="alkacon.mercury.template.messages" />
            </resourcebundles>
            <searchsettings containerPageOnly="true" />
            <FieldSettings>
                <Setting>
                    <PropertyName>Eyebrow</PropertyName>
                    <DisplayName><![CDATA[%(key.label.gb.Eyebrow)]]></DisplayName>
                    <Widget>string</Widget>
                </Setting>
                <Setting>
                    <PropertyName>Title</PropertyName>
                    <DisplayName><![CDATA[%(key.label.gb.Title)]]></DisplayName>
                    <Widget>string</Widget>
                    <WidgetConfig><![CDATA[%(attribute:stringConfigTypo)]]></WidgetConfig>
                </Setting>
                <Setting>
                    <PropertyName>Intro</PropertyName>
                    <DisplayName><![CDATA[%(key.label.gb.References.Intro)]]></DisplayName>
                    <Widget>html</Widget>
                    <WidgetConfig><![CDATA[%(attribute:editorConfigMinimal:%(param:editorConfigMinimal))]]></WidgetConfig>
                </Setting>
                <Setting>
                    <PropertyName>Reference</PropertyName>
                    <DisplayName><![CDATA[%(key.label.gb.Reference)]]></DisplayName>
                    <Description><![CDATA[%(key.label.gb.Reference.help)]]></Description>
                </Setting>
                <Setting>
                    <PropertyName>Reference/Title</PropertyName>
                    <DisplayName><![CDATA[%(key.label.gb.Reference.Title)]]></DisplayName>
                    <Widget>string</Widget>
                </Setting>
                <Setting>
                    <PropertyName>Reference/Subtitle</PropertyName>
                    <DisplayName><![CDATA[%(key.label.gb.Reference.Subtitle)]]></DisplayName>
                    <Widget>string</Widget>
                </Setting>
                <Setting>
                    <PropertyName>Reference/Count</PropertyName>
                    <DisplayName><![CDATA[%(key.label.gb.Reference.Count)]]></DisplayName>
                    <Description><![CDATA[%(key.label.gb.Reference.Count.help)]]></Description>
                    <Widget>string</Widget>
                </Setting>
                <Setting>
                    <PropertyName>Reference/Link</PropertyName>
                    <DisplayName><![CDATA[%(key.label.Link)]]></DisplayName>
                </Setting>
                <Setting>
                    <PropertyName>GalleryTitle</PropertyName>
                    <DisplayName><![CDATA[%(key.label.GalleryTitle)]]></DisplayName>
                    <Widget>string</Widget>
                    <Default><![CDATA[%(page_title)%(no_prefix:: )%(value:Title)]]></Default>
                    <DefaultResolveMacros>false</DefaultResolveMacros>
                    <Search>false</Search>
                    <Visibility>ROLE.WORKPLACE_USER</Visibility>
                    <Mapping>
                       <MapTo>property:Title</MapTo>
                       <UseDefault>true</UseDefault>
                    </Mapping>
                </Setting>
            </FieldSettings>
        </xsd:appinfo>
    </xsd:annotation>
</xsd:schema>
