<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

    <xsd:include schemaLocation="opencms://opencms-xmlcontent.xsd" />
    <xsd:include schemaLocation="opencms://system/modules/alkacon.mercury.template/schemas/nested/link.xsd" />

    <xsd:element name="GbStateGridData" type="OpenCmsGbStateGridData" />

    <xsd:complexType name="OpenCmsGbStateGridData">
        <xsd:sequence>
            <xsd:element name="GbStateGrid" type="OpenCmsGbStateGrid" minOccurs="0" maxOccurs="1" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="OpenCmsGbStateGrid">
        <xsd:sequence>
            <xsd:element name="Eyebrow"      type="OpenCmsString" minOccurs="0" />
            <xsd:element name="Title"        type="OpenCmsString" />
            <xsd:element name="Tile"         type="OpenCmsGbStateTile" minOccurs="0" maxOccurs="unbounded" />
            <xsd:element name="GalleryTitle" type="OpenCmsString" minOccurs="0" />
        </xsd:sequence>
        <xsd:attribute name="language" type="OpenCmsLocale" use="required" />
    </xsd:complexType>

    <xsd:complexType name="OpenCmsGbStateTile">
        <xsd:sequence>
            <xsd:element name="Name"   type="OpenCmsString" />
            <xsd:element name="Status" type="OpenCmsString" />
            <xsd:element name="Link"   type="OpenCmsNestedLink" minOccurs="0" />
            <xsd:element name="Note"   type="OpenCmsString" minOccurs="0" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:annotation>
        <xsd:appinfo>
            <resourcebundles>
                <propertybundle name="com.mapexplorer.geobonus.messages" />
                <propertybundle name="alkacon.mercury.template.messages" />
            </resourcebundles>
            <searchsettings containerPageOnly="true" />
            <FieldSettings>
                <Setting>
                    <PropertyName>Eyebrow</PropertyName>
                    <DisplayName><![CDATA[%(key.label.gb.Eyebrow)]]></DisplayName>
                    <Widget>string</Widget>
                </Setting>
                <Setting>
                    <PropertyName>Title</PropertyName>
                    <DisplayName><![CDATA[%(key.label.gb.Title)]]></DisplayName>
                    <Widget>string</Widget>
                    <WidgetConfig><![CDATA[%(attribute:stringConfigTypo)]]></WidgetConfig>
                </Setting>
                <Setting>
                    <PropertyName>Tile</PropertyName>
                    <DisplayName><![CDATA[%(key.label.gb.Tile)]]></DisplayName>
                    <Description><![CDATA[%(key.label.gb.Tile.help)]]></Description>
                </Setting>
                <Setting>
                    <PropertyName>Tile/Name</PropertyName>
                    <DisplayName><![CDATA[%(key.label.gb.Tile.Name)]]></DisplayName>
                    <Widget>string</Widget>
                </Setting>
                <Setting>
                    <PropertyName>Tile/Status</PropertyName>
                    <DisplayName><![CDATA[%(key.label.gb.Tile.Status)]]></DisplayName>
                    <Widget>select</Widget>
                    <WidgetConfig><![CDATA[live:%(key.label.gb.Tile.Status.live)|pending:%(key.label.gb.Tile.Status.pending)]]></WidgetConfig>
                    <Default><![CDATA[live]]></Default>
                </Setting>
                <Setting>
                    <PropertyName>Tile/Link</PropertyName>
                    <DisplayName><![CDATA[%(key.label.Link)]]></DisplayName>
                </Setting>
                <Setting>
                    <PropertyName>Tile/Note</PropertyName>
                    <DisplayName><![CDATA[%(key.label.gb.Tile.Note)]]></DisplayName>
                    <Widget>string</Widget>
                </Setting>
                <Setting>
                    <PropertyName>GalleryTitle</PropertyName>
                    <DisplayName><![CDATA[%(key.label.GalleryTitle)]]></DisplayName>
                    <Widget>string</Widget>
                    <Default><![CDATA[%(page_title)%(no_prefix:: )%(value:Title)]]></Default>
                    <DefaultResolveMacros>false</DefaultResolveMacros>
                    <Search>false</Search>
                    <Visibility>ROLE.WORKPLACE_USER</Visibility>
                    <Mapping>
                       <MapTo>property:Title</MapTo>
                       <UseDefault>true</UseDefault>
                    </Mapping>
                </Setting>
            </FieldSettings>
        </xsd:appinfo>
    </xsd:annotation>
</xsd:schema>
