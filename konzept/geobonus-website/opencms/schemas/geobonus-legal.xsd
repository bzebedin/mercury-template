<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

    <xsd:include schemaLocation="opencms://opencms-xmlcontent.xsd" />

    <xsd:element name="GbLegalData" type="OpenCmsGbLegalData" />

    <xsd:complexType name="OpenCmsGbLegalData">
        <xsd:sequence>
            <xsd:element name="GbLegal" type="OpenCmsGbLegal" minOccurs="0" maxOccurs="1" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="OpenCmsGbLegal">
        <xsd:sequence>
            <xsd:element name="Eyebrow"      type="OpenCmsString" minOccurs="0" />
            <xsd:element name="Title"        type="OpenCmsString" />
            <xsd:element name="Subtitle"     type="OpenCmsString" minOccurs="0" />
            <xsd:element name="Intro"        type="OpenCmsHtml" minOccurs="0" />
            <xsd:element name="Section"      type="OpenCmsGbLegalSection" minOccurs="0" maxOccurs="unbounded" />
            <xsd:element name="GalleryTitle" type="OpenCmsString" minOccurs="0" />
        </xsd:sequence>
        <xsd:attribute name="language" type="OpenCmsLocale" use="required" />
    </xsd:complexType>

    <xsd:complexType name="OpenCmsGbLegalSection">
        <xsd:sequence>
            <xsd:element name="Heading" type="OpenCmsString" />
            <xsd:element name="Body"    type="OpenCmsHtml" />
        </xsd:sequence>
    </xsd:complexType>

    <xsd:annotation>
        <xsd:appinfo>
            <resourcebundles>
                <propertybundle name="com.mapexplorer.geobonus.messages" />
                <propertybundle name="alkacon.mercury.template.messages" />
            </resourcebundles>
            <searchsettings containerPageOnly="true" />
            <FieldSettings>
                <Setting>
                    <PropertyName>Eyebrow</PropertyName>
                    <DisplayName><![CDATA[%(key.label.gb.Eyebrow)]]></DisplayName>
                    <Widget>string</Widget>
                </Setting>
                <Setting>
                    <PropertyName>Title</PropertyName>
                    <DisplayName><![CDATA[%(key.label.gb.Title)]]></DisplayName>
                    <Widget>string</Widget>
                    <WidgetConfig><![CDATA[%(attribute:stringConfigTypo)]]></WidgetConfig>
                </Setting>
                <Setting>
                    <PropertyName>Subtitle</PropertyName>
                    <DisplayName><![CDATA[%(key.label.gb.Subtitle)]]></DisplayName>
                    <Widget>string</Widget>
                </Setting>
                <Setting>
                    <PropertyName>Intro</PropertyName>
                    <DisplayName><![CDATA[%(key.label.gb.Legal.Intro)]]></DisplayName>
                    <Widget>html</Widget>
                    <WidgetConfig><![CDATA[%(attribute:editorConfigMinimal:%(param:editorConfigMinimal))]]></WidgetConfig>
                </Setting>
                <Setting>
                    <PropertyName>Section</PropertyName>
                    <DisplayName><![CDATA[%(key.label.gb.Legal.Section)]]></DisplayName>
                    <Description><![CDATA[%(key.label.gb.Legal.Section.help)]]></Description>
                </Setting>
                <Setting>
                    <PropertyName>Section/Heading</PropertyName>
                    <DisplayName><![CDATA[%(key.label.gb.Legal.Section.Heading)]]></DisplayName>
                    <Widget>string</Widget>
                </Setting>
                <Setting>
                    <PropertyName>Section/Body</PropertyName>
                    <DisplayName><![CDATA[%(key.label.gb.Legal.Section.Body)]]></DisplayName>
                    <Widget>html</Widget>
                    <WidgetConfig><![CDATA[%(attribute:editorConfigFull:%(param:editorConfigFull))]]></WidgetConfig>
                </Setting>
                <Setting>
                    <PropertyName>GalleryTitle</PropertyName>
                    <DisplayName><![CDATA[%(key.label.GalleryTitle)]]></DisplayName>
                    <Widget>string</Widget>
                    <Default><![CDATA[%(page_title)%(no_prefix:: )%(value:Title)]]></Default>
                    <DefaultResolveMacros>false</DefaultResolveMacros>
                    <Search>false</Search>
                    <Visibility>ROLE.WORKPLACE_USER</Visibility>
                    <Mapping>
                       <MapTo>property:Title</MapTo>
                       <UseDefault>true</UseDefault>
                    </Mapping>
                </Setting>
            </FieldSettings>
        </xsd:appinfo>
    </xsd:annotation>
</xsd:schema>
